{
  "name": "local-event-calendar-server",
  "version": "1.0.0",
  "description": "Backend API for Local Event Calendar Management System",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "build": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:generate:pg": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:pg": "prisma migrate dev --schema=prisma/schema.postgresql.prisma",
    "prisma:deploy:pg": "prisma migrate deploy --schema=prisma/schema.postgresql.prisma",
    "prisma:push": "prisma db push",
    "prisma:push:pg": "prisma db push --schema=prisma/schema.postgresql.prisma",
    "prisma:seed": "node prisma/seed.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^5.22.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
