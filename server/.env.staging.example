# ==============================================================================
# EventHub Server Environment Configuration (Staging)
# ==============================================================================
PORT=5000
NODE_ENV=staging

# Staging PostgreSQL database (e.g. Neon, Supabase, or Staging Container)
DATABASE_URL="postgresql://staging_user:REPLACE_WITH_STRONG_STAGING_PASSWORD@staging-db.eventhub.internal:5432/eventhub_staging?schema=public&connection_limit=20&pool_timeout=10&sslmode=require"

# Cryptographically random staging JWT secret (Generated via `openssl rand -hex 32`)
JWT_SECRET="REPLACE_WITH_64_CHAR_HEX_RANDOM_STAGING_JWT_SECRET"
JWT_EXPIRES_IN="7d"

# Staging Frontend Client URL (e.g. Vercel preview or staging subdomain)
CLIENT_URL="https://staging.eventhub.app,https://eventhub-staging.vercel.app"

