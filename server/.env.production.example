# ==============================================================================
# EventHub Server Environment Configuration (Production)
# ==============================================================================
PORT=5000
NODE_ENV=production

# Production PostgreSQL database (Managed Cloud: Neon, AWS RDS, GCP Cloud SQL, Supabase)
DATABASE_URL="postgresql://prod_user:REPLACE_WITH_STRONG_PRODUCTION_PASSWORD@prod-db.eventhub.internal:5432/eventhub_production?schema=public&connection_limit=20&pool_timeout=10&sslmode=require"

# Cryptographically random production JWT secret (Generated via `openssl rand -hex 64`)
JWT_SECRET="REPLACE_WITH_128_CHAR_HEX_RANDOM_PRODUCTION_JWT_SECRET"
JWT_EXPIRES_IN="7d"

# Production Frontend Client URLs for CORS (comma-separated list)
CLIENT_URL="https://eventhub.app,https://www.eventhub.app"

