# ==============================================================================
# EventHub Server Environment Configuration (Production)
# ==============================================================================
PORT=5000
NODE_ENV=production

# Production PostgreSQL database (Managed Cloud: Neon Serverless PostgreSQL 16)
# Runtime Pooled Connection (Used by Express backend via PgBouncer)
DATABASE_URL="postgresql://prod_user:REPLACE_WITH_STRONG_PRODUCTION_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/eventhub_production?sslmode=require&pgbouncer=true"

# Direct Unpooled Connection (Used exclusively by Prisma CLI for migrations and schema DDL)
DIRECT_URL="postgresql://prod_user:REPLACE_WITH_STRONG_PRODUCTION_PASSWORD@ep-sample.us-east-2.aws.neon.tech/eventhub_production?sslmode=require"

# Cryptographically random production JWT secret (Generated via `openssl rand -hex 64`)
JWT_SECRET="REPLACE_WITH_128_CHAR_HEX_RANDOM_PRODUCTION_JWT_SECRET"
JWT_EXPIRES_IN="7d"

# Production Frontend Client URLs for CORS (comma-separated list)
CLIENT_URL="https://eventhub.app,https://www.eventhub.app"

