# ==============================================================================
# EventHub Server Environment Configuration (Development)
# ==============================================================================
PORT=5000
NODE_ENV=development

# Database connection: PostgreSQL 16 (DATABASE_URL for pooled runtime, DIRECT_URL for migrations)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/eventhub_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/eventhub_dev?schema=public"

# Cryptographic JWT Secret (Minimum 32 characters in production)
JWT_SECRET="eventhub-super-secret-jwt-key-2026-production"
JWT_EXPIRES_IN="7d"

# Allowed client origins for CORS (single URL or comma-separated list)
CLIENT_URL="http://localhost:5173,http://127.0.0.1:5173"
