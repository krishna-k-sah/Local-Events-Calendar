# ==============================================================================
# EventHub Client Environment Configuration (Production / Staging)
# ==============================================================================
# For production where frontend and backend are deployed on distinct subdomains:
# Example: https://api.eventhub.app/api or https://eventhub-backend.onrender.com/api
# If served under reverse-proxy on same domain, set to /api
VITE_API_BASE_URL=https://api.eventhub.app/api

